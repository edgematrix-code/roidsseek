# Copy this file to .env and fill in the real values.
# .env is never committed; real environment variables override it.

APP_NAME=RoidsSeek
APP_URL=
APP_DEBUG=true
APP_CURRENCY=USD
FREE_SHIPPING_THRESHOLD=399
SHIPPING_FLAT_RATE=25

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=roidsseek
DB_USERNAME=root
DB_PASSWORD=change-me
DB_CHARSET=utf8mb4

# Used only by database/seed.php. ADMIN_PASSWORD is required and the script
# refuses to run without it, so the demo admin never gets a guessable password.
ADMIN_EMAIL=admin@roidsseek.com
ADMIN_PASSWORD=change-me-before-seeding
