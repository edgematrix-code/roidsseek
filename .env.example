[TEMPLATE]
# Copy this file to .env and fill in the real values.
# .env is never committed; real environment variables override it.
# Blank values are treated as "not supplied": dependent output is omitted,
# never rendered as a placeholder. Run `php tools/config_check.php` to see
# exactly which fields are still empty.

# ------------------------------------------------------------------- core
APP_NAME=RoidsSeek
APP_URL=https://www.roidsseek.io
APP_DEBUG=false
APP_CURRENCY=USD
# Minimum price a single product may be sold for, and the minimum basket
# subtotal needed to place an order.
MIN_PRODUCT_PRICE=100
MIN_ORDER_TOTAL=500
SHIPPING_INTERNATIONAL_RATE=25
SHIPPING_DOMESTIC_RATE=30
# Promo offer: entering this code on a basket at or above the threshold grants
# the fixed discount AND free delivery. The coupon row is created by
# database/seed.php (fresh installs) or database/migrate.php (existing ones).
PROMO_CODE=ROIDSSEEK2026
FREE_SHIPPING_THRESHOLD=1000
BULK_DISCOUNT_THRESHOLD=1000
BULK_DISCOUNT_AMOUNT=200


# Used only by database/seed.php. ADMIN_PASSWORD is required and the script
# refuses to run without it, so the demo admin never gets a guessable password.
ADMIN_EMAIL=admin@roidsseek.com
ADMIN_PASSWORD=Admin@12345
# --------------------------------------------------------------- identity
SITE_STORE_NAME=RoidsSeek
# Canonical root URL. Absolute URLs, sitemaps, robots.txt and the feed use it.
# Production build fails without it. Also accepts APP_URL as a fallback.
SITE_URL=https://www.roidsseek.io
SITE_LEGAL_NAME=
SITE_TAGLINE=
SITE_COUNTRY=US
SITE_REGION=
SITE_CITY=
SITE_LOCALE=en_US
SITE_LANGUAGE=en
SITE_TIMEZONE=America/New_York
SITE_ADDRESS_STREET=
SITE_ADDRESS_POSTAL=
SITE_GEO_LAT=
SITE_GEO_LNG=
SITE_PHONE=
SITE_WHATSAPP=
SITE_EMAIL=roidsseeksupp@tutanota.com
# Pipe-separated, schema.org form: Mo-Su 09:00-18:00
SITE_OPENING_HOURS=
# Only set true when the published address is staffed and may be shown.
SITE_HAS_PHYSICAL_LOCATION=false
SITE_SOCIAL_X=
SITE_SOCIAL_INSTAGRAM=
SITE_SOCIAL_FACEBOOK=
SITE_SOCIAL_TELEGRAM=
SITE_LOGO_PATH=assets/img/77094.webp
SITE_OG_IMAGE=assets/images/og-default.png
SITE_DEFAULT_DESCRIPTION=

# ------------------------------------------------------------------- mail
# Where the contact form, order confirmations and payment notices are sent
# from, and how they leave the server.
#
# Leave MAIL_HOST empty to hand the message to PHP mail(). On a shared host
# that often goes nowhere: set MAIL_HOST/PORT/USERNAME/PASSWORD to the mailbox
# you created in hPanel (Hostinger: Emails -> Email Accounts -> Connect Apps)
# so mail is submitted through authenticated SMTP and actually delivered.
#
# MAIL_FROM must be on your own domain (never www.roidsseek.io), otherwise
# SPF/DKIM fail and receivers bin the message. Leave it blank for
# no-reply@roidsseek.io.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# tls = STARTTLS (587), ssl = implicit TLS (465), none = plain (25)
MAIL_ENCRYPTION=tls
MAIL_FROM=
MAIL_FROM_NAME=RoidsSeek Support

# ------------------------------------------------------------- regulatory
# Published only when filled. Never inferred or invented.
REG_STATE_LICENCE=
REG_STATE_BOARD=
REG_DEA=
REG_PIC_NAME=
REG_PIC_LICENCE=
# Neutral names for the policy pages; never inferred from the country.
REG_MEDICINES_REGULATOR=
REG_DATA_PROTECTION_LAW=
# certified | pending | not_certified
REG_NABP_VIPPS_STATUS=
REG_LEGITSCRIPT_STATUS=
REG_GOOGLE_PHARMACY_STATUS=

# ---------------------------------------------------------------- editorial
# Health content stays noindex until a named reviewer is configured here.
EDITORIAL_AUTHOR_NAME=
EDITORIAL_REVIEWER_NAME=
EDITORIAL_REVIEWER_CREDENTIALS=
EDITORIAL_REVIEWER_LICENCE=
EDITORIAL_REVIEWER_NPI=
EDITORIAL_LAST_REVIEWED=

# ----------------------------------------------------------- prescriptions
# Upload size cap for prescription files, in MB (clamped to 1-20).
# Uploads are written to storage/prescriptions/, which must be writable by PHP
# and is never served over HTTP.
RX_MAX_MB=8

# ----------------------------------------------------------------- Bitcoin
# Public receive address only. Never put a private key or seed phrase here.
BTC_ADDRESS=bc1q9take6d97hd9wthp7g2g3kttrly0k4sx84w2c8
BTC_LABEL=RoidsSeek order payment
BTC_CONFIRMATIONS=2
# Optional manual USD/BTC rate used to lock the BTC amount at checkout.
# Leave blank to show the USD total and confirm the BTC amount by support.
BTC_USD_RATE=

# ---------------------------------------------------------------- Ethereum
# Public receive address only. Never put a private key or seed phrase here.
ETH_ADDRESS=0x40839B08ac24B45F91f15E7B681467e35EAF156A
ETH_LABEL=RoidsSeek order payment
ETH_CONFIRMATIONS=12
# Optional manual USD/ETH rate. Leave blank to show the USD total and confirm
# the ETH amount by support.
ETH_USD_RATE=

# ------------------------------------------------- payment page (checkout)
# Signs the portable link that lets a guest reopen their payment page.
# Leave blank and the page stays reachable only from the placing browser.
PAYMENT_GUEST_SECRET=
PAYMENT_GUEST_TTL_MINUTES=1440
# Minutes the customer has to send the BTC amount before the order expires.
PAYMENT_WINDOW_MINUTES=15
PAYMENT_NETWORK=Bitcoin
PAYMENT_TOKEN=Bitcoin (BTC)

# --------------------------------------------------------------------- SEO
# Search Console verification token (content value of the meta tag).
GSC_VERIFICATION=
# GA4 measurement ID, e.g. G-XXXXXXX. Analytics loads only after consent.
GA4_MEASUREMENT_ID=
# true = emit path URLs (/shop/{slug}, /collections/{slug}, /learn/{slug}) and
# 301 index.php?r= / index.php?p= to them. On by default; requires the rewrite
# rules in .htaccess / router.php to be active.
SEO_CLEAN_URLS=true
# true = 301 requests on any other host/protocol to SITE_URL. Enabled: www is
# the canonical host, so the bare domain redirects to https://www.roidsseek.io.
SEO_CANONICAL_REDIRECT=true
# true = deindex the whole site: "noindex,nofollow" on every page plus the
# X-Robots-Tag header on every response. Off by default; the site is indexable.
SEO_NOINDEX=false
# Google Merchant Center feed. Off until the country and medicine policy are confirmed.
SEO_MERCHANT_FEED=false
SEO_MERCHANT_COUNTRY=
SITE_TITLE_SUFFIX=
