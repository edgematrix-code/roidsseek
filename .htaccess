# Apache: never expose credentials or application internals.
<IfModule mod_authz_core.c>
    <FilesMatch "^\.">
        Require all denied
    </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule "(^|/)\.(?!well-known)" - [F]
    RewriteRule ^(app|config|database|tests|legacy)/ - [F]
</IfModule>
